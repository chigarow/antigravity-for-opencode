# ============================================
# Antigravity / agy / Google auth tokens & credentials
# These contain your Gemini / agy access tokens.
# NEVER commit them.
# ============================================

# Antigravity CLI main auth directory and files
.antigravity/
**/.antigravity/
antigravity-accounts.json
**/*antigravity*.json
**/*agy*.json

